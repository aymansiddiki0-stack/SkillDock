{
  "manifest_version": 3,
  "name": "SkillDock",
  "version": "0.0.1",
  "description": "Fills the Skills section of Workday job applications.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SkillDock",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
