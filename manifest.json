{
  "manifest_version": 3,
  "name": "SkillDock",
  "version": "1.1.0",
  "description": "Fills the Skills section of Workday job applications from your saved skill list, adding a skill only when Workday offers an exact match. Not affiliated with Workday, Inc.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SkillDock",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
